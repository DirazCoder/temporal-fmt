{
  "name": "temporal-fmt",
  "version": "0.8.981",
  "description": "Format Temporal.PlainDate/PlainDateTime/PlainTime/ZonedDateTime objects using date-fns-style token strings.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "temporal-fmt": "./scripts/cli.mjs"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./format": {
      "import": {
        "types": "./dist/format.d.ts",
        "default": "./dist/format.js"
      },
      "require": {
        "types": "./dist/format.d.cts",
        "default": "./dist/format.cjs"
      }
    },
    "./parse": {
      "import": {
        "types": "./dist/parse.d.ts",
        "default": "./dist/parse.js"
      },
      "require": {
        "types": "./dist/parse.d.cts",
        "default": "./dist/parse.cjs"
      }
    },
    "./duration": {
      "import": {
        "types": "./dist/duration.d.ts",
        "default": "./dist/duration.js"
      },
      "require": {
        "types": "./dist/duration.d.cts",
        "default": "./dist/duration.cjs"
      }
    },
    "./relative": {
      "import": {
        "types": "./dist/relativeTime.d.ts",
        "default": "./dist/relativeTime.js"
      },
      "require": {
        "types": "./dist/relativeTime.d.cts",
        "default": "./dist/relativeTime.cjs"
      }
    },
    "./interval": {
      "import": {
        "types": "./dist/interval.d.ts",
        "default": "./dist/interval.js"
      },
      "require": {
        "types": "./dist/interval.d.cts",
        "default": "./dist/interval.cjs"
      }
    },
    "./calendar": {
      "import": {
        "types": "./dist/calendarUtils.d.ts",
        "default": "./dist/calendarUtils.js"
      },
      "require": {
        "types": "./dist/calendarUtils.d.cts",
        "default": "./dist/calendarUtils.cjs"
      }
    },
    "./timezone": {
      "import": {
        "types": "./dist/timezone.d.ts",
        "default": "./dist/timezone.js"
      },
      "require": {
        "types": "./dist/timezone.d.cts",
        "default": "./dist/timezone.cjs"
      }
    },
    "./recurrence": {
      "import": {
        "types": "./dist/recurrence.d.ts",
        "default": "./dist/recurrence.js"
      },
      "require": {
        "types": "./dist/recurrence.d.cts",
        "default": "./dist/recurrence.cjs"
      }
    },
    "./locale": {
      "import": {
        "types": "./dist/localeRegistry.d.ts",
        "default": "./dist/localeRegistry.js"
      },
      "require": {
        "types": "./dist/localeRegistry.d.cts",
        "default": "./dist/localeRegistry.cjs"
      }
    }
  },
  "files": [
    "dist",
    "scripts/cli.mjs",
    "format.d.ts",
    "format.d.cts",
    "parse.d.ts",
    "parse.d.cts",
    "duration.d.ts",
    "duration.d.cts",
    "relative.d.ts",
    "relative.d.cts",
    "interval.d.ts",
    "interval.d.cts",
    "calendar.d.ts",
    "calendar.d.cts",
    "timezone.d.ts",
    "timezone.d.cts",
    "recurrence.d.ts",
    "recurrence.d.cts",
    "locale.d.ts",
    "locale.d.cts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly && node scripts/emit-cjs-types.mjs && node scripts/emit-node10-shims.mjs",
    "dev": "tsup --watch",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "c8 --include=\"dist/**/*.js\" --exclude=\"dist/**/*.cjs\" --exclude=\"dist/**/*.map\" --exclude=\"dist/**/*.d.ts\" --exclude=\"dist/**/*.d.cts\" --check-coverage --lines 100 --branches 100 --functions 100 --statements 100 -r text node --max-old-space-size=4096 scripts/run-tests.mjs",
    "test:types": "vitest run --typecheck",
    "test:pack": "attw --pack . && publint .",
    "test:smoke": "node smoke-test/run.mjs",
    "test:all": "npm run build && npm test && npm run test:coverage && npm run test:unit && npm run test:types && npm run test:pack && npm run test:smoke",
    "cli": "node scripts/cli.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "temporal",
    "date",
    "time",
    "format",
    "tc39"
  ],
  "license": "MIT",
  "author": {
    "name": "DirazCoder",
    "url": "https://github.com/DirazCoder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DirazCoder/temporal-fmt.git"
  },
  "bugs": {
    "url": "https://github.com/DirazCoder/temporal-fmt/issues"
  },
  "homepage": "https://github.com/DirazCoder/temporal-fmt#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "c8": "^12.0.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "temporal-polyfill": "^1.0.4"
  },
  "overrides": {
    "esbuild": "0.28.2"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
