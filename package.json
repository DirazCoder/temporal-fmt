{
  "name": "temporal-fmt",
  "version": "0.8.2",
  "description": "Format Temporal.PlainDate/PlainDateTime/PlainTime/ZonedDateTime objects using date-fns-style token strings.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly && node scripts/emit-cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "c8 --include=\"dist/index.js\" --include=\"dist/index.cjs\" --check-coverage --lines 90 --branches 75 --functions 88 -r text node scripts/run-tests.mjs",
    "test:types": "vitest run --typecheck",
    "test:pack": "attw --pack . && publint .",
    "test:all": "npm run build && npm test && npm run test:coverage && npm run test:unit && npm run test:types && npm run test:pack",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "temporal",
    "date",
    "time",
    "format",
    "tc39"
  ],
  "license": "MIT",
  "author": {
    "name": "DirazCoder",
    "url": "https://github.com/DirazCoder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DirazCoder/temporal-fmt.git"
  },
  "bugs": {
    "url": "https://github.com/DirazCoder/temporal-fmt/issues"
  },
  "homepage": "https://github.com/DirazCoder/temporal-fmt#readme",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "c8": "^12.0.0",
    "publint": "^0.3.23",
    "temporal-polyfill": "^1.0.4",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}