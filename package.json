{
  "name": "temporal-fmt",
  "version": "0.7.95",
  "description": "Format Temporal.PlainDate/PlainDateTime/PlainTime/ZonedDateTime objects using date-fns-style token strings.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup && tsc --declaration --emitDeclarationOnly",
    "dev": "tsup --watch",
    "test": "node --test test/*.test.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:types": "vitest run --typecheck",
    "test:all": "npm run build && npm test && npm run test:unit && npm run test:types",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "temporal",
    "date",
    "time",
    "format",
    "tc39"
  ],
  "license": "MIT",
  "author": {
    "name": "DirazCoder",
    "url": "https://github.com/DirazCoder"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DirazCoder/temporal-fmt.git"
  },
  "bugs": {
    "url": "https://github.com/DirazCoder/temporal-fmt/issues"
  },
  "homepage": "https://github.com/DirazCoder/temporal-fmt#readme",
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "temporal-polyfill": "^1.0.3",
    "tsup": "^8.5.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "esbuild": "0.28.1"
  },
  "engines": {
    "node": ">=20"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}